---
import { Picture } from 'astro:assets';
import approachPoster from '../assets/posters/approach.png';
import { getDictionary, type Locale } from '../i18n';
import { labelAnchors } from '../lib/rings/labels';
import { noWidow } from '../lib/typography';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
// Label dots sit where the docked 3D view puts each ring — computed at build time from the scene's own maths.
const labels = labelAnchors();
const percent = (value: number): string => `${(value * 100).toFixed(2)}%`;
---

<section id="approach" class="approach container" aria-labelledby="approach-label">
  <div class="approach-grid">
    <figure class="approach-figure" data-reveal="fade">
      <div class="approach-stage" data-stage="approach" role="img" aria-label={t.approach.diagramAlt}>
        <Picture
          src={approachPoster}
          alt=""
          formats={['avif', 'webp']}
          widths={[420, 640, 860, 1080, 1360]}
          sizes="(min-width: 64rem) min(38vw, 960px), min(100vw, 26rem)"
          loading="lazy"
          pictureAttributes={{ class: 'stage-poster' }}
        />
        <div class="stage-labels" aria-hidden="true">
          {
            labels.map((label) => (
              <span class="stage-label" data-ring={label.key} data-dir={label.dir} style={`--x: ${percent(label.x)}; --y: ${percent(label.y)}`}>
                <span class="label stage-label-text">{t.approach.rings[label.key].toLocaleUpperCase(lang)}</span>
              </span>
            ))
          }
        </div>
      </div>
      <figcaption class="fig-caption"><span class="fig-num">{t.approach.fig}</span> — {noWidow(t.approach.caption)}</figcaption>
    </figure>
    <div class="approach-text">
      <h2 id="approach-label" class="label" data-reveal="fade">{t.approach.label}</h2>
      <p class="approach-lead" data-reveal="fade-up">
        {
          t.approach.lead.map((seg) =>
            typeof seg === 'string' ? seg
            : 'ring' in seg ? <span class="hl" data-ring={seg.ring}>{seg.text}</span>
            : <span class="mark" data-mark={seg.mark}>{seg.text}</span>,
          )
        }
      </p>
      <p class="approach-body" data-reveal="fade-up" data-reveal-delay="0.12">{t.approach.body}</p>
    </div>
  </div>
</section>

<style>
  .approach {
    padding-block: var(--section-y);
  }
  .approach-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 3.5rem;
    align-items: center;
  }
  .approach-figure {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    grid-column: 1 / -1;
    justify-self: center;
    /* Where the knot docks the grid's top is in view: on short phones the stage gives up height so the caption, label
       and lead (about 25rem below it) still fit under it while the sequence plays. */
    width: min(100%, 26rem, max(14rem, 100svh - 25rem));
  }
  .approach-figure .fig-caption {
    max-width: 24rem;
  }
  .approach-stage {
    position: relative;
    aspect-ratio: 1;
    container-type: inline-size;
  }
  .approach-stage :global(.stage-poster),
  .approach-stage :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .stage-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* A zero-size anchor at the dot; the live scene draws it with --draw (0..1), posters leave it at 1. */
  .stage-label {
    --len: 7cqi;
    position: absolute;
    left: var(--x);
    top: var(--y);
    transition: opacity 0.3s var(--ease-std);
  }
  /* While one ring is singled out (scripts/rings/overlay.ts) the other two labels step back with their rings. */
  .stage-labels[data-focus] .stage-label:not([data-lit]) {
    opacity: 0.3;
  }
  .stage-label::before {
    content: '';
    position: absolute;
    left: -2.5px;
    top: -2.5px;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background: var(--ink);
    transform: scale(min(1, calc(var(--draw, 1) * 4)));
  }
  .stage-label::after {
    content: '';
    position: absolute;
    left: -0.5px;
    width: 1px;
    height: var(--len);
    background: var(--label);
    transform: scaleY(var(--draw, 1));
  }
  .stage-label[data-dir='up']::after {
    bottom: 0;
    transform-origin: 50% 100%;
  }
  .stage-label[data-dir='down']::after {
    top: 0;
    transform-origin: 50% 0;
  }
  .stage-label-text {
    position: absolute;
    left: 0;
    translate: -50% 0;
    white-space: nowrap;
    opacity: clamp(0, calc(var(--draw, 1) * 2 - 1), 1);
  }
  /* The engineering label hangs off the knot's left tip; set its text mostly left of the leader so it clears the
     porcelain ring on narrow stages. */
  .stage-label[data-ring='engineering'] .stage-label-text {
    translate: -75% 0;
  }
  .stage-label[data-dir='up'] .stage-label-text {
    bottom: calc(var(--len) + 0.375rem);
  }
  .stage-label[data-dir='down'] .stage-label-text {
    top: calc(var(--len) + 0.375rem);
  }
  .approach-text {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    grid-column: 1 / -1;
  }
  .approach-lead {
    font-size: var(--fs-lead);
    font-weight: 300;
    line-height: 1.14;
    letter-spacing: -0.032em;
    text-wrap: pretty;
  }
  /* A ring's word; underlined while its ring is singled out, the way links underline on hover. */
  .hl {
    cursor: default;
    background: linear-gradient(currentColor, currentColor) 0 94% / 0 max(1px, 0.035em) no-repeat;
    transition: background-size 0.35s var(--ease-std);
  }
  .hl[data-lit] {
    background-size: 100% max(1px, 0.035em);
  }
  .approach-body {
    max-width: 29.5rem;
    font-size: var(--fs-body-l);
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }
  /* A phone on its side has no height for the stacked grid: stage and text side by side, as on desktop, so the docked
     grid shows the rings and the lead together. */
  @media (orientation: landscape) and (max-width: 63.99rem) and (max-height: 30rem) {
    .approach-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      /* Top-aligned: the text column runs past the viewport, and a centred figure would drop its caption below it. */
      align-items: start;
    }
    .approach-figure {
      grid-column: 1;
      width: min(100%, 100svh - 7rem);
    }
    .approach-text {
      grid-column: 2;
      gap: 1.5rem;
    }
  }
  @media (min-width: 64rem) {
    .approach-figure {
      grid-column: 1 / span 5;
      justify-self: stretch;
      width: auto;
    }
    /* The rings sit half a gutter into the margin so their drawn edge, not the square around them, meets the grid;
       the caption below stays on the grid line. */
    .approach-stage {
      margin-left: -0.5rem;
    }
    .approach-text {
      grid-column: 7 / span 6;
      gap: 2.5rem;
    }
  }
</style>
